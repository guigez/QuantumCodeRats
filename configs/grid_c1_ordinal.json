{
  "base": {
    "model_name": "hybrid_resnet50",
    "head": "bottleneck",
    "output": "ordinal",
    "n_qubits": 8,
    "n_layers": 4,
    "c1_hidden": "match",
    "c1_match": "strongly",
    "input_size": [224, 224],
    "pretrained": true,
    "train_layer4": true,
    "epochs": 200,
    "patience": 15,
    "lr_patience": 6,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "head_learning_rate": 0.001,
    "weight_decay": 0.0001,
    "use_class_weights": true,
    "class_weight_scheme": "balanced",
    "augment": true,
    "hflip": false,
    "num_workers": 4,
    "selection_metric": "f1_macro"
  },
  "grid": {
    "n_qubits": [4, 6, 8],
    "n_layers": [1, 2, 4],
    "core_learning_rate": [0.001, 0.01],
    "c1_match": ["strongly", "basic"]
  },
  "selection": {
    "metric": "val_f1_macro"
  },
  "skip_tasks": ["binary"],
  "_nota_skip": "com duas classes a saida ordinal e uma regressao logistica, equivalente a softmax",
  "_nota_grid": "Grid espelhado do H3, igual ao do C1: n_qubits {4, 6, 8} x n_layers {1, 2, 4} x core_learning_rate {1e-3, 1e-2} x c1_match {strongly, basic}: 36 candidatos. Controle classico do H3."
}
